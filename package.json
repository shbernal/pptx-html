{
	"name": "pptx-html",
	"version": "0.2.1",
	"author": {
		"name": "shbernal",
		"url": "https://github.com/shbernal/"
	},
	"description": "Turn HTML from the DOM into editable PowerPoint presentations via pptx-ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shbernal/pptx-html.git"
	},
	"bugs": {
		"url": "https://github.com/shbernal/pptx-html/issues"
	},
	"homepage": "https://shbernal.github.io/pptx-html/",
	"keywords": [
		"pptx",
		"powerpoint",
		"html",
		"dom",
		"slides",
		"presentation",
		"ooxml"
	],
	"license": "MIT",
	"packageManager": "pnpm@12.11.2",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": {
			"default": "./package.json"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"start": "pnpm run watch",
		"watch": "tsdown --watch",
		"test": "pnpm run build && vitest run",
		"test:unit": "vitest run --project unit",
		"test:oracle": "vitest run --project oracle",
		"oracle:score": "node test/surface/score.ts",
		"test:browser": "vitest run --project browser",
		"test:watch": "vitest --watch --project unit",
		"site:prepare": "node site/scripts/sync-docs.ts && node site/scripts/check-samples.ts && node site/scripts/build-ledger.ts",
		"site:dev": "pnpm run build && pnpm run site:prepare && vitepress dev site",
		"site:build": "pnpm run build && pnpm run site:prepare && vitepress build site",
		"site:preview": "vitepress preview site",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p site/tsconfig.json --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "oxlint && oxfmt --check",
		"check:fix": "oxlint --fix && oxfmt",
		"knip": "knip",
		"lint:chars": "charcheck",
		"lint:chars:fix": "charcheck --fix",
		"example": "node examples/round-trip.mjs",
		"prepare": "lefthook install",
		"prepack": "pnpm run build",
		"prepublishOnly": "pnpm run typecheck && pnpm run check && pnpm run test:oracle"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^5.0.3",
		"@vue/compiler-sfc": "^3.5.43",
		"charcheck": "^0.4.0",
		"knip": "^6.41.0",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"playwright": "^1.64.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitepress": "2.0.0-alpha.20",
		"vitest": "^5.0.3",
		"vue": "^3.5.43"
	},
	"dependencies": {
		"pptx-ts": "^4.1.1-next.123.g41e5746"
	}
}
